# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI / MONGO_URI: MongoDB Atlas connection string (set automatically by Vercel MongoDB integration).
# Uses local JSON persistence when omitted or unreachable.
MONGODB_URI=
MONGO_URI=
MONGODB_DB=kitabwanag

# JWT_SECRET: Long random secret (>= 16 chars) used to sign auth tokens across serverless restarts.
JWT_SECRET=

# SUPABASE_URL, SUPABASE_SECRET_KEY (or legacy SUPABASE_SERVICE_ROLE_KEY): Recommended persistent photo storage via Supabase Storage.
# Uses a public bucket (defaults to "book-covers"; auto-created on first upload if missing).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=book-covers

# Optional direct-browser Supabase Storage fallback when hosting static frontend without /api/uploads:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=book-covers

# CLOUDINARY_URL (or individual CLOUDINARY_* vars): Optional Cloudinary credentials for image hosting.
# Format: CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@oofqig04
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FRONTEND_URL: Allowed origin for CORS in split deployments (e.g. https://kitabwanag.vercel.app).
FRONTEND_URL=https://kitabwanag.vercel.app

# VITE_API_URL: Optional backend base URL when frontend and backend are hosted separately.
VITE_API_URL=

# RESEND_API_KEY, RESEND_FROM: Optional email delivery settings for password reset links.
RESEND_API_KEY=
RESEND_FROM=

